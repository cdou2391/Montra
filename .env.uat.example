# UAT: the production images and topology, on plain HTTP.
#
# Identical to .env.production except for the three things TLS would otherwise
# be required for. MONTRA_ENV is what decides all of them:
#
#   * production refuses to start on an unsafe setting; uat does not check.
#   * production sends HSTS. On localhost that would pin the whole hostname to
#     HTTPS for a year and break the development stack on :8080 with it.
#   * production forces Secure on the session cookie whatever the file says,
#     so a browser on http:// would never keep a session.
#
# Everything else is production: the same multi-stage images, the same
# one-shot migration job, the same proxy-only port. Copy to .env.uat and
# replace the CHANGE-ME values.
#
#   docker compose -p montra-uat --env-file .env.uat \
#     -f docker-compose.prod.yml up -d --build

MONTRA_ENV=uat
MONTRA_DEBUG=false
MONTRA_ENV_FILE=.env.uat

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=montra
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=montra
DATABASE_URL=postgresql+psycopg://montra:CHANGE-ME@postgres:5432/montra

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Sessions ---------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=CHANGE-ME
# The point of this file. On http:// a Secure cookie is never stored, so the
# session would be lost on every request and sign-in would appear to fail.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Origins ----------------------------------------------------------------
# Plain HTTP, which production would refuse.
CORS_ORIGINS=http://localhost:8090
SAME_ORIGINS=http://localhost:8090

# --- Object storage ---------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
# Signed URLs are signed for the host the browser uses, so this is the public
# origin rather than the internal one.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8090
S3_REGION=us-east-1
S3_BUCKET=montra-attachments
S3_ACCESS_KEY=montra
S3_SECRET_KEY=CHANGE-ME

# --- Frontend ---------------------------------------------------------------
API_ORIGIN=http://api:8000

# --- Proxy ------------------------------------------------------------------
# 8090, so the development stack keeps 8080 and both can run at once.
PROXY_PORT=8090
