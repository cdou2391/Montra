# ---------------------------------------------------------------------------
# Montra — local development environment
# Copy to .env before running `docker compose up`.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=montra
POSTGRES_PASSWORD=montra_dev_password
POSTGRES_DB=montra
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
MONTRA_ENV=development
MONTRA_DEBUG=true
DATABASE_URL=postgresql+psycopg://montra:montra_dev_password@postgres:5432/montra
TEST_DATABASE_URL=postgresql+psycopg://montra:montra_dev_password@postgres:5432/montra_test
REDIS_URL=redis://redis:6379/0

# Session cookie. SECRET_KEY must be replaced outside development.
SECRET_KEY=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=montra_session
SESSION_TTL_HOURS=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — the frontend origin
CORS_ORIGINS=http://localhost:3000

# Frontend
# Relative, so the browser always calls the API on whatever origin it
# loaded the app from. Works on localhost and behind the proxy alike.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the dev server forwards /api when reached directly on :3000.
API_ORIGIN=http://api:8000
