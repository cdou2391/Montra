# Production environment. Copy to .env.production and replace every value
# marked CHANGE-ME; the API refuses to start on any of the development
# defaults (see production_problems in app/core/config.py).

MONTRA_ENV=production
MONTRA_DEBUG=false

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=montra
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=montra
DATABASE_URL=postgresql+psycopg://montra:CHANGE-ME@postgres:5432/montra

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Sessions ---------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=CHANGE-ME
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Origins ----------------------------------------------------------------
# The public HTTPS origin this is served on. Plain HTTP is refused in
# production, and so is a wildcard.
CORS_ORIGINS=https://CHANGE-ME
SAME_ORIGINS=https://CHANGE-ME

# --- Object storage ---------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
# Signed URLs are signed for the host the browser will use, so this is the
# public origin rather than the internal one.
S3_PUBLIC_ENDPOINT_URL=https://CHANGE-ME
S3_REGION=us-east-1
S3_BUCKET=montra-attachments
S3_ACCESS_KEY=montra
S3_SECRET_KEY=CHANGE-ME

# --- Frontend ---------------------------------------------------------------
API_ORIGIN=http://api:8000

# --- Proxy ------------------------------------------------------------------
# Behind a TLS terminator (a tunnel, or another nginx), this stays on a local
# port. Exposed directly, it wants 443 and a certificate.
PROXY_PORT=8080
