# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Runtime state written into the bind-mounted source tree by containers.
# Celery Beat rewrites this dbm file on every tick.
backend/celerybeat-schedule
backend/celerybeat.pid

# Env
.env
.env.local
.env.*.local
# Every environment file except the checked-in templates. .env.production
# holds real credentials and must never be committed.
.env.*
!.env.example
!.env.production.example
!.env.uat.example

# Editor / OS
.DS_Store
.idea/
.vscode/

# pnpm content-addressable cache. A build fetches from the lockfile, so this
# is a local cache rather than a source, and it carries files far past what
# GitHub will accept.
frontend/.pnpm-store/

# The specification set. Kept locally as the source of truth for behaviour,
# deliberately not published.
docs/
